<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Without it the connectivity manager does not report an active network to this app. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The ACTION BUBBLE overlay window floats on top of every screen, which needs the special
         "Display over other apps" permission (granted through its own settings page, not a
         runtime dialog). The bubble service only inserts its window once this is granted. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Declared so the bubble's brightness slider can request the special "Modify system
         settings" grant (Settings.System.canWrite) from its own page; without it the slider
         snaps back and opens the grant screen instead. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- Without this declaration the launcher never shows up in the "Do Not Disturb access"
         list, so the bubble's DND toggle could ask for the grant but never receive it. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Needed to detect RetroArch and deep-link games into it on Android 11+. -->
        <package android:name="com.retroarch" />
        <package android:name="com.retroarch.aarch64" />
        <package android:name="com.retroarch.ra32" />
        <package android:name="com.retroarch.ra64" />
    </queries>

    <application
        android:label="Console Launcher"
        android:allowBackup="false"
        android:theme="@style/Theme.ConsoleLauncher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

        </activity>

        <service
            android:name=".bubble.ActionBubbleService"
            android:exported="false" />
    </application>

</manifest>
